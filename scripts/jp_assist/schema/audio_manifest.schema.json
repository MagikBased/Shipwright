{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JP Assist optional spoken-word audio manifest",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sampleType": {"const": "spoken-word"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wordId", "wordAudio"],
        "properties": {
          "wordId": {"type": "string", "minLength": 1},
          "wordAudio": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
