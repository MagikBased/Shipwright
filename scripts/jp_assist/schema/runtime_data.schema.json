{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oot-jp-assist.local/runtime_data.schema.json",
  "title": "OoT JP Assist runtime corpus",
  "type": "object",
  "required": ["metadata", "messages"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schemaVersion", "pipelineVersion", "corpusVersion", "messageCount", "alignmentCounts"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "pipelineVersion": { "type": "string" },
        "corpusVersion": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string" },
        "messageCount": { "type": "integer", "minimum": 0 },
        "alignmentCounts": {
          "type": "object",
          "required": ["exact", "reviewed", "unresolved"],
          "properties": {
            "exact": { "type": "integer", "minimum": 0 },
            "reviewed": { "type": "integer", "minimum": 0 },
            "unresolved": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "additionalProperties": true
    },
    "messages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/message" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "message": {
      "type": "object",
      "required": ["schemaVersion", "source", "pages"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "source": {
          "type": "object",
          "required": ["variant", "messageId", "japaneseMessageId", "englishMessageIds", "alignmentStatus", "alignmentConfidence", "japaneseHash", "englishHash", "englishHashes"],
          "properties": {
            "variant": { "type": "string" },
            "messageId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{4}$" },
            "japaneseMessageId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{4}$" },
            "englishMessageIds": {
              "type": "array",
              "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{4}$" },
              "uniqueItems": true
            },
            "alignmentStatus": { "enum": ["exact", "reviewed", "unresolved"] },
            "alignmentConfidence": { "type": "integer", "minimum": 0, "maximum": 100 },
            "japaneseHash": { "type": ["string", "null"] },
            "englishHash": { "type": ["string", "null"] },
            "englishHashes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/page" }
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["japanese", "english", "isChoice", "choiceCount", "englishSource", "tokens"],
      "properties": {
        "japanese": { "type": "string" },
        "english": { "type": "string" },
        "isChoice": { "type": "boolean" },
        "choiceCount": { "type": "integer", "minimum": 0 },
        "englishSource": {
          "type": ["object", "null"],
          "properties": {
            "messageId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{4}$" },
            "pageIndex": { "type": "integer", "minimum": 0 }
          },
          "required": ["messageId", "pageIndex"]
        },
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } }
      }
    },
    "token": {
      "type": "object",
      "required": ["id", "occurrenceId", "senseId", "surface", "lemma", "reading", "dictionaryReading", "partOfSpeech", "meaning", "start", "length"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "occurrenceId": { "type": "string", "minLength": 1 },
        "senseId": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "lemma": { "type": "string", "minLength": 1 },
        "reading": { "type": "string" },
        "dictionaryReading": { "type": "string" },
        "partOfSpeech": { "type": "string" },
        "meaning": { "type": "string" },
        "note": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
