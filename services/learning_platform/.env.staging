# Local production-equivalent staging defaults. This file contains no secrets
# suitable for a public deployment.
JP_ASSIST_ENV_FILE=.env.staging
JP_ASSIST_DOMAIN=localhost
JP_ASSIST_ENV=production
JP_ASSIST_PLATFORM_DB=/data/platform.sqlite3
JP_ASSIST_COOKIE_SECURE=1
JP_ASSIST_ALLOWED_HOSTS=localhost,127.0.0.1,app
JP_ASSIST_PUBLIC_BASE_URL=https://localhost:8443
JP_ASSIST_MAIL_TRANSPORT=smtp
JP_ASSIST_SMTP_HOST=mailpit
JP_ASSIST_SMTP_PORT=1025
JP_ASSIST_SMTP_FROM=JP Assist <no-reply@jp-assist.invalid>
JP_ASSIST_SMTP_STARTTLS=0
JP_ASSIST_TRUST_PROXY_HEADERS=1
JP_ASSIST_STRUCTURED_LOGS=1
JP_ASSIST_BACKUP_DIR=/backups
JP_ASSIST_BACKUP_INTERVAL_SECONDS=86400
JP_ASSIST_BACKUP_RETAIN_COUNT=14
JP_ASSIST_MAINTENANCE_INTERVAL_SECONDS=3600
JP_ASSIST_RATE_LIMIT_WINDOW_SECONDS=60
JP_ASSIST_AUTH_RATE_LIMIT=20
JP_ASSIST_PAIRING_RATE_LIMIT=180
JP_ASSIST_EVENT_RATE_LIMIT=180
JP_ASSIST_BIND_ADDRESS=127.0.0.1
JP_ASSIST_HTTP_PORT=8080
JP_ASSIST_HTTPS_PORT=8443
JP_ASSIST_MAILPIT_PORT=8025
JP_ASSIST_PROMETHEUS_PORT=9090
JP_ASSIST_GRAFANA_PORT=3000
JP_ASSIST_GRAFANA_ADMIN_PASSWORD=local-only-change-before-public-use
