{$JP_ASSIST_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	@internal path /internal/*
	respond @internal 404
	reverse_proxy app:8766

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' http://127.0.0.1:8765"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
