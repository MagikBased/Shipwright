{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "jp-assist-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(jp_assist_http_requests_total[5m]))", "legendFormat": "requests"}],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "jp-assist-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(jp_assist_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(jp_assist_http_requests_total[5m])), 1e-9)", "legendFormat": "5xx ratio"}],
      "title": "Error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "jp-assist-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(jp_assist_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}],
      "title": "Request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "jp-assist-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "jp_assist_ready", "legendFormat": "ready"}],
      "title": "Ready",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "jp-assist-prometheus"},
      "fieldConfig": {"defaults": {"unit": "decbytes"}, "overrides": []},
      "gridPos": {"h": 6, "w": 5, "x": 4, "y": 8},
      "id": 5,
      "targets": [{"expr": "jp_assist_database_bytes", "legendFormat": "database"}],
      "title": "Database size",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "jp-assist-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 5, "x": 9, "y": 8},
