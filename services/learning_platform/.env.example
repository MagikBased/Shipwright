# Copy to .env and replace this with the public DNS name pointed at the host.
JP_ASSIST_DOMAIN=learn.example.com

JP_ASSIST_ENV=production
JP_ASSIST_PLATFORM_DB=/data/platform.sqlite3
JP_ASSIST_COOKIE_SECURE=1
# Include loopback/internal names used by container health checks.
JP_ASSIST_ALLOWED_HOSTS=learn.example.com,127.0.0.1,localhost,app

# Trust X-Forwarded-For only because Compose makes the app reachable solely
# through the bundled Caddy service. Disable this if the app is directly exposed.
JP_ASSIST_TRUST_PROXY_HEADERS=1

# Requests allowed per identity during the window. Zero disables a category.
JP_ASSIST_RATE_LIMIT_WINDOW_SECONDS=60
JP_ASSIST_AUTH_RATE_LIMIT=20
JP_ASSIST_PAIRING_RATE_LIMIT=180
JP_ASSIST_EVENT_RATE_LIMIT=180
